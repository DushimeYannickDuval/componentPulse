# Django settings
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.railway.app

# Database (Railway will set DATABASE_URL automatically when you attach Postgres)
# Example: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DB_ENGINE=django.db.backends.postgresql
DB_NAME=cpulse
DB_USER=cpulse
DB_PASSWORD=cpulse
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS/CSRF
# Set to your frontend URL (e.g., https://your-frontend.up.railway.app)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://*.railway.app

# Logging
DJANGO_LOG_LEVEL=INFO

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
